PORT=3000

# Saat production (backend juga menyajikan tampilan), aplikasi dibuka di http://IP-SERVER:PORT.
# NODE_ENV=production

# Cookie login hanya lewat HTTPS? Default: ya kalau NODE_ENV=production.
# Kalau diakses lewat http://IP-server (tanpa HTTPS), WAJIB isi false, kalau tidak user tidak bisa login.
# COOKIE_SECURE=false

# Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL="mysql://root:@localhost:3306/pud_online_system"

# Kunci rahasia untuk token login. Isi dengan string acak panjang, contoh hasil perintah:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Akun admin awal yang dibuat oleh `npm run db:seed`
SEED_ADMIN_EMAIL="admin@pud.local"
SEED_ADMIN_PASSWORD="admin123"
